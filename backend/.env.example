# Copy to .env and adjust for your machine.
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)

# --- ASR: fine-tuned Hafs + Bazzi models (required for Surah Al-Baqarah) ---
ASR_BACKEND=transformers
CUSTOM_MODEL_PATH=./models/qurany-whisper-base-al-baqarah
BAZZI_MODEL_PATH=./models/qurany-whisper-base-al-baqarah-bazzi

# CPU inference (use WHISPER_DEVICE=cuda if you have a working GPU)
WHISPER_DEVICE=cpu

# Local pip (when ASR_BACKEND=transformers):
#   pip install -r requirements.txt
#   pip install torch --index-url https://download.pytorch.org/whl/cpu
#   pip install -r requirements-transformers.txt
# Or run: .\scripts\install-deps.ps1

# Optional: faster-whisper fallback when ASR_BACKEND=faster_whisper
# WHISPER_MODEL=OdyAsh/faster-whisper-base-ar-quran
# WHISPER_COMPUTE_TYPE=int8

# --- Auth / DB (SQLite for local dev; created automatically on startup) ---
JWT_SECRET=change-me-in-production
# DATABASE_URL=sqlite:///data/qurany.db
