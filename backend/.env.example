# Application
APP_NAME=qurany-backend
APP_ENV=development
DEBUG=true
# Uvicorn auto-reload. Set false when using ASR_BACKEND=transformers (heavy model).
UVICORN_RELOAD=true
HOST=0.0.0.0
PORT=8000

# CORS (JSON list). Use ["*"] for local dev; lock down for production.
CORS_ORIGINS=["*"]

# ASR backend: faster_whisper (default) | transformers
ASR_BACKEND=faster_whisper

# faster-whisper settings (used when ASR_BACKEND=faster_whisper)
# WHISPER_MODEL: tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# WHISPER_COMPUTE_TYPE: int8 (CPU) | int8_float16 | float16 (GPU) | float32
WHISPER_COMPUTE_TYPE=int8
# WHISPER_DEVICE: auto | cpu | cuda
# Use cpu on Windows unless CUDA 12+ and cuBLAS are fully installed.
WHISPER_DEVICE=cpu
WHISPER_BEAM_SIZE=5
ASR_LANGUAGE=ar

# transformers backend (used when ASR_BACKEND=transformers) — path or HF repo
# id of a fine-tuned Whisper checkpoint, e.g. the Kaggle Hafs Al-Baqarah fine-tune
# extracted into backend/models/. Requires `pip install transformers torch`.
# CUSTOM_MODEL_PATH=./models/qurany-whisper-base-al-baqarah

# Bazzi 'an Ibn Kathir model (always uses transformers when riwayah=bazzi on API).
# Hafs settings above are unchanged — pass riwayah=hafs (default) to keep current behavior.
BAZZI_MODEL_PATH=./models/qurany-whisper-base-al-baqarah-bazzi

# Best-effort Tajweed heuristics (Madd/Ghunnah/Waqf/Qalqalah); Qalqalah needs
# `pip install librosa`.
ENABLE_TAJWEED_HEURISTICS=true

# Reference text (Surah Al-Naba is seeded locally under data/surah_naba/;
# other supported surahs, e.g. 2, are fetched once and cached under
# data/surah_cache/)
ALQURAN_API_BASE=https://api.alquran.cloud/v1
REFERENCE_FETCH_FALLBACK=true

# Comparison
SIMILARITY_THRESHOLD=0.6

# Flag correct-letter words with wrong/missing harakat as a mistake (needs
# a diacritic-outputting ASR, e.g. the transformers fine-tune; auto-skipped
# when the transcript has no tashkeel at all).
ENABLE_HARAKAT_CHECK=true

# Partial-recitation alignment (Al-Baqarah): auto-detect ayah window vs full surah
AUTO_DETECT_AYAH_RANGE=true

# transformers decode tuning (when ASR_BACKEND=transformers)
WHISPER_NUM_BEAMS=5
WHISPER_CHUNK_OVERLAP_SECONDS=2.0
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true

# Database (PostgreSQL recommended; SQLite used if unset)
# FastAPI/SQLAlchemy (psycopg driver):
DATABASE_URL=postgresql+psycopg://qurany:qurany@localhost:5432/qurany
# Prisma Studio / db pull (standard postgres URL, no driver prefix):
PRISMA_DATABASE_URL=postgresql://qurany:qurany@localhost:5432/qurany

# JWT auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080
