# Copy to .env and adjust for your machine.
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)

# --- ASR: fine-tuned Hafs + Bazzi models (required for Surah Al-Baqarah) ---
ASR_BACKEND=transformers
CUSTOM_MODEL_PATH=./models/qurany-whisper-base-al-baqarah
BAZZI_MODEL_PATH=./models/qurany-whisper-base-al-baqarah-bazzi

# CPU inference (use WHISPER_DEVICE=cuda if you have a working GPU)
WHISPER_DEVICE=cpu

# Optional: faster-whisper fallback when ASR_BACKEND=faster_whisper
# WHISPER_MODEL=OdyAsh/faster-whisper-base-ar-quran
# WHISPER_COMPUTE_TYPE=int8

# --- Auth / DB (defaults are fine for local dev) ---
JWT_SECRET=change-me-in-production
# DATABASE_URL=sqlite:///data/qurany.db
