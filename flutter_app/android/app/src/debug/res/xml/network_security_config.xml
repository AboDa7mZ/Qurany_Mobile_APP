<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds: allow HTTP to any host so LAN backend IPs work without
  editing this file each time your PC's address changes.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
